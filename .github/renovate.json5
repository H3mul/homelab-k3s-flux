{
    "autodiscover": false,
    "dryRun": null,
    "printConfig": false,
    "dependencyDashboardAutoclose": true,
    "ignoreTests": true,
    "platform": "github",
    "repositories": ["H3mul/homelab-k3s-flux"],
    "baseBranches": ["main"],
    "ignorePaths": [
        "disabled/**",
        
        // Too critical for auto updates
        "provision/**",
        "cluster/cilium/**",
        "cluster/cilium-bgp-loadbalancer/**"
    ],
    "ignoreDeps": [
        "cilium" // Too critical for auto updates
    ],
    "extends": [
        "config:best-practices",
        ":dependencyDashboard",
        ":automergeMinor",
        ":automergeDigest",
        ":automergePatch",
        ":automergePr",
        ":disableRateLimiting",
        ":docker"
    ],
    "automergeType": "pr",
    "flux": {
        "fileMatch": ["\\.yaml$"]
    },
    "helm-values": {
        "fileMatch": ["\\.yaml$"]
    },
    "docker-compose": {
        "fileMatch": ["\\.yaml$"]
    },
    // Mattermost operator splits the image: image name lives in `image`,
    // while the tag and digest ride along in `version` (image:version).
    "regexManagers": [
        {
            "fileMatch": ["\\.yaml$"],
            "matchStrings": [
                "image:\\s*(?<depName>[\\w./-]+)\\s*\\n(?:\\s*#.*\\n)?\\s*version:\\s*(?<currentValue>[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker",
            "depNameTemplate": "{{{depName}}}",
            "currentValueTemplate": "{{{currentValue}}}",
            "currentDigestTemplate": "{{{currentDigest}}}"
        }
    ],
    "packageRules": [
        {
            // The regex manager above handles this image via `version`;
            // stop the docker-compose/helm-values managers (whose fileMatch hits every .yaml) from pinning a digest onto `image`.
            "matchManagers": ["docker-compose", "helm-values", "kubernetes", "dockerfile"],
            "matchPackageNames": ["mattermost/mattermost-team-edition"],
            "enabled": false
        }
    ]
}
